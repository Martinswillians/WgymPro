rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// Will Gym PRO — regras do Firestore (v53: vínculo personal ↔ aluno + notificações + sessões + chat)
// Publique em: Firebase Console → Firestore Database → Regras.
// ATENÇÃO: se você já tem regras para  users/{uid}/...  mantenha o bloco "users" abaixo
// (ou mescle). Sem estas regras o app continua funcionando normalmente para treinar,
// mas as solicitações/treinos do personal retornam "permission-denied".
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function linkDoc(personal, student) {
      return get(/databases/$(database)/documents/links/$(personal + '_' + student));
    }
    function linkAccepted(personal, student) {
      return exists(/databases/$(database)/documents/links/$(personal + '_' + student))
          && linkDoc(personal, student).data.status == 'accepted';
    }

    function contactExists(a, b) {
      let id = a < b ? a + '_' + b : b + '_' + a;
      return exists(/databases/$(database)/documents/contacts/$(id));
    }
    function contactAccepted(a, b) {
      let id = a < b ? a + '_' + b : b + '_' + a;
      return exists(/databases/$(database)/documents/contacts/$(id))
          && get(/databases/$(database)/documents/contacts/$(id)).data.status == 'accepted';
    }
    // pode conversar: contato aceito OU vínculo personal ↔ aluno aceito (em qualquer sentido)
    function canChat(a, b) { return contactAccepted(a, b) || linkAccepted(a, b) || linkAccepted(b, a); }

    // Dados do próprio usuário (sync do app)
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // O personal só pode LER o histórico de treinos do aluno, e somente com vínculo aceito
    match /users/{uid}/data/{key} {
      allow read: if signedIn() && key == 'wgym_history' && linkAccepted(request.auth.uid, uid);
    }

    // Diretório para encontrar alguém pelo e-mail exato (id = e-mail em minúsculas, codificado)
    match /directory/{emailKey} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Vínculos: id = personalUid_studentUid
    match /links/{linkId} {
      // get() de um vínculo que ainda não existe precisa ser permitido (resource == null)
      allow get: if signedIn() && (resource == null ||
        resource.data.personalUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
      allow list: if signedIn() &&
        (resource.data.personalUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
      allow create: if signedIn()
        && linkId == request.resource.data.personalUid + '_' + request.resource.data.studentUid
        && (request.resource.data.personalUid == request.auth.uid || request.resource.data.studentUid == request.auth.uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == (request.resource.data.personalUid == request.auth.uid ? 'personal' : 'student');
      // só quem RECEBEU a solicitação pode aceitar; quem pediu não pode se auto-aceitar
      allow update: if signedIn()
        && (resource.data.personalUid == request.auth.uid || resource.data.studentUid == request.auth.uid)
        && request.resource.data.personalUid == resource.data.personalUid
        && request.resource.data.studentUid == resource.data.studentUid
        && (request.resource.data.status != 'accepted'
            || resource.data.requestedBy != (resource.data.personalUid == request.auth.uid ? 'personal' : 'student'));
      allow delete: if signedIn() &&
        (resource.data.personalUid == request.auth.uid || resource.data.studentUid == request.auth.uid);

      // Recados entre os dois
      match /messages/{mid} {
        allow read: if signedIn() &&
          (get(/databases/$(database)/documents/links/$(linkId)).data.personalUid == request.auth.uid
           || get(/databases/$(database)/documents/links/$(linkId)).data.studentUid == request.auth.uid);
        allow create: if signedIn() && request.resource.data.from == request.auth.uid &&
          (get(/databases/$(database)/documents/links/$(linkId)).data.personalUid == request.auth.uid
           || get(/databases/$(database)/documents/links/$(linkId)).data.studentUid == request.auth.uid);
      }
    }

    // Notificações (sininho): quem tem vínculo com o destinatário pode criar; só o destinatário lê, marca como lida e apaga
    match /notifications/{nid} {
      allow get: if signedIn() && (resource == null || resource.data.toUid == request.auth.uid);
      allow list: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.read == false
        && (exists(/databases/$(database)/documents/links/$(request.auth.uid + '_' + request.resource.data.toUid))
            || exists(/databases/$(database)/documents/links/$(request.resource.data.toUid + '_' + request.auth.uid))
            || contactExists(request.auth.uid, request.resource.data.toUid));
      allow update: if signedIn() && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.toUid == request.auth.uid;
    }

    // Sessões registradas pelo personal no celular dele para o aluno (id = personalUid_studentUid_idDoExercicio).
    // O personal cria (só com vínculo aceito); o aluno lê, importa para o próprio histórico e apaga.
    match /sessions/{sid} {
      allow get: if signedIn() && (resource == null ||
        resource.data.personalUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
      allow list: if signedIn() &&
        (resource.data.personalUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.personalUid == request.auth.uid
        && request.resource.data.studentUid != request.auth.uid
        && sid.matches(request.auth.uid + '_' + request.resource.data.studentUid + '_.*')
        && linkAccepted(request.auth.uid, request.resource.data.studentUid);
      allow update: if signedIn()
        && resource.data.personalUid == request.auth.uid
        && request.resource.data.personalUid == request.auth.uid
        && request.resource.data.studentUid == resource.data.studentUid
        && linkAccepted(request.auth.uid, request.resource.data.studentUid);
      allow delete: if signedIn() &&
        (resource.data.personalUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
    }

    // Contatos entre pessoas (id = uidA_uidB em ordem alfabética). Só o destinatário aceita.
    match /contacts/{cid} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.uids);
      allow list: if signedIn() && request.auth.uid in resource.data.uids;
      allow create: if signedIn()
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && cid == request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid in resource.data.uids
        && request.resource.data.uids == resource.data.uids
        && request.resource.data.requestedBy == resource.data.requestedBy
        && (request.resource.data.status != 'accepted'
            || resource.data.status == 'accepted'
            || resource.data.requestedBy != request.auth.uid);
      allow delete: if signedIn() && request.auth.uid in resource.data.uids;
    }

    // Chat: conversas diretas (d_<uidA>_<uidB>) e grupos (g_<id>). Mensagens em chats/{id}/messages.
    match /chats/{cid} {
      allow get: if signedIn() && (resource == null
        || request.auth.uid in resource.data.members || request.auth.uid in resource.data.pending);
      allow list: if signedIn()
        && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.pending);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.pending is list
        && (
          (request.resource.data.type == 'direct'
            && request.resource.data.members.size() == 2
            && request.resource.data.pending.size() == 0
            && request.resource.data.members[0] < request.resource.data.members[1]
            && cid == 'd_' + request.resource.data.members[0] + '_' + request.resource.data.members[1]
            && canChat(request.resource.data.members[0], request.resource.data.members[1]))
          ||
          (request.resource.data.type == 'group'
            && request.resource.data.members.size() == 1
            && request.resource.data.pending.size() <= 30
            && cid.matches('g_.*'))
        );
      allow update: if signedIn() && (
        // (A) membro: última mensagem, não lidas, recibo de leitura (só a própria chave), convites e nomes
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastMessage', 'updatedAt', 'unread', 'reads', 'pending', 'memberNames', 'name'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reads'])
              || request.resource.data.reads.diff(resource.data.reads).affectedKeys().hasOnly([request.auth.uid])))
        // (B) sair do grupo
        || (resource.data.type == 'group'
          && request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt']))
        // (C) aceitar convite para o grupo
        || (resource.data.type == 'group'
          && request.auth.uid in resource.data.pending
          && request.auth.uid in request.resource.data.members
          && !(request.auth.uid in request.resource.data.pending)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'pending', 'updatedAt']))
        // (D) recusar convite
        || (request.auth.uid in resource.data.pending
          && !(request.auth.uid in request.resource.data.pending)
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pending']))
      );
      allow delete: if false;

      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members;
        allow update: if false;
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }

    // Treinos montados pelo personal para o aluno
    match /plans/{planId} {
      allow get: if signedIn() && (resource == null ||
        resource.data.personalUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
      allow list: if signedIn() &&
        (resource.data.personalUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.personalUid == request.auth.uid
        && linkAccepted(request.auth.uid, request.resource.data.studentUid);
      allow delete: if signedIn() &&
        (resource.data.personalUid == request.auth.uid || resource.data.studentUid == request.auth.uid);
    }
  }
}
